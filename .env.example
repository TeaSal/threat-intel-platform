# Copy this file to .env and fill in real values before running with --live

# Required for AbuseIPDB collector: https://www.abuseipdb.com/register (free tier)
ABUSEIPDB_API_KEY=your_abuseipdb_key_here

# Optional but recommended for NVD collector (raises rate limit from 5 to 50 req/30s)
# https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=your_nvd_key_here
